# Copy to .env (never commit real secrets).
# PostgreSQL in production, e.g. postgresql+psycopg://user:pass@host/reppilot
DATABASE_URL=sqlite:///./reppilot.db
# Long random string. Required when REPPILOT_ENV=production.
JWT_SECRET=change-me
REPPILOT_ENV=development
# Comma-separated emails that get the moderator role.
MODERATOR_EMAILS=
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
MEDIA_DIR=./media
